# Cluster topology for the Sovereign Agent Workbench.
# Copy to cluster.conf and edit. cluster.conf is GITIGNORED -- never commit a
# file containing real addresses or hostnames from your site.
#
# Use HOSTNAMES (.local mDNS) or the cluster-fabric IPs, never the management
# LAN addresses of someone else's lab.

# Node that coordinates Ray and serves the HTTP endpoint.
HEAD=spark-head.local

# Space-separated list of the other nodes.
WORKERS="spark-w1.local spark-w2.local"

# Interface Ray/NCCL should use for inter-node traffic.
# On DGX Spark the CX7 fabric ports are enp1s0f*/enP2p1s0f*; the management
# port is enP7s7. Pick a CX7 interface that is on a subnet ALL nodes share.
RAY_IFACE=enp1s0f1np1

# Where the model lives (identical path on every node).
MODEL_DIR=$HOME/models-<name>
MODEL_ID=$HOME/models-<name>/models--<org>--<model>/snapshots/<snapshot-hash>
SERVED_NAME=nemotron-ultra-253b

# Parallelism.
#   PP (pipeline) = split the model's LAYERS across nodes, assembly-line style.
#   TP (tensor)   = split each layer across nodes; requires
#                   num_attention_heads % TP == 0.
# Nemotron-Ultra-253B has 128 heads and 162 layers:
#   TP=3 is IMPOSSIBLE (128 % 3 != 0); PP=3 is exact (162 / 3 = 54).
PP=3
TP=1

MAX_LEN=16384
GPU_UTIL=0.90
PORT=8000
IMAGE=vllm/vllm-openai:latest

# Intake model (OPTIONAL): a second, single-node model that catalogues
# documents uploaded at the booth. Leave INTAKE_MODEL_DIR empty to skip it --
# uploads then fall back to a deterministic parser and questions still work.
# 0.42 util on a 75 GiB checkpoint left no room for KV cache and the engine
# refused to start; 0.80 on a 121 GiB node is correct.
INTAKE_MODEL_DIR=
INTAKE_GPU_UTIL=0.80
INTAKE_MAXLEN=16384
